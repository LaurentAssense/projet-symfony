{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h1 class="h3 mb-0 text-center">Créez votre compte</h1>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'autocomplete': 'off'}}) }}
                        <div class="mb-3">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                            <div class="form-error">
                                {{ form_errors(form.email) }}
                            </div>
                        </div>

                        {% set password_error = form.password.vars.errors|length > 0 %}
                        <div class="mb-3">
                            {{ form_label(form.password.first) }}
                            {{ form_widget(form.password.first, {'attr': {'class': 'form-control' ~ (password_error ? ' is-invalid' : '')}}) }}
                            <div class="form-error">
                                {{ form_errors(form.password.first) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.password.second) }}
                            {{ form_widget(form.password.second, {'attr': {'class': 'form-control' ~ (password_error ? ' is-invalid' : '')}}) }}
                            <div class="form-error">
                                {{ form_errors(form.password.second) }}
                                {{ form_errors(form.password) }}
                            </div>
                        </div>
                        
                        <div class="d-grid">
                            {{ form_widget(form.submit, {'attr': {'class': 'btn btn-primary'}}) }}
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
